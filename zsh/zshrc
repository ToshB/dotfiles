# ---------- homebrew ----------
# .zprofile covers login shells; this catches non-login interactive shells too.
[[ -z "$HOMEBREW_PREFIX" ]] && eval "$(/opt/homebrew/bin/brew shellenv)"

# ---------- completions ----------
# Homebrew's completion functions (installed to site-functions)
FPATH="/opt/homebrew/share/zsh/site-functions:${FPATH}"
autoload -Uz compinit && compinit
# case-insensitive matching, menu selection
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'
zstyle ':completion:*' menu select

# ---------- history ----------
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt SHARE_HISTORY          # share across open tabs
setopt HIST_IGNORE_ALL_DUPS   # drop older duplicates
setopt HIST_REDUCE_BLANKS
setopt EXTENDED_HISTORY       # record timestamps

# ---------- colors ----------
export CLICOLOR=1
export LSCOLORS=ExGxBxDxCxEgEdxbxgxcxd
alias ls='ls -G'
alias ll='ls -lhG'
alias la='ls -lahG'
alias grep='grep --color=auto'

# ---------- git aliases ----------
alias gst='git status'
alias gco='git checkout'
alias gd='git diff'
alias gl='git log --oneline --graph --decorate -20'
alias gp='git push'
alias ga='git add'
alias gc='git commit'

# ---------- plugins ----------
# autosuggestions: ghost-text completion from history (accept with the right arrow)
source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh

# search history by what you have already typed (up/down arrow)
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey '^[[A' up-line-or-beginning-search
bindkey '^[[B' down-line-or-beginning-search

# ---------- prompt ----------
eval "$(starship init zsh)"

# ---------- zoxide ----------
# replaces cd with a frecency-ranked version; `cdi` for an interactive pick.
# plain `cd /some/path` still works exactly as before.
eval "$(zoxide init zsh --cmd cd)"
# keep the classic zoxide names working too, for muscle memory
alias z='cd'
alias zi='cdi'

# ---------- fzf ----------
# ctrl-r fuzzy history | ctrl-t file picker | alt-c cd into a subdir
# tab completion is unchanged; type ** before tab for the fuzzy version
export FZF_DEFAULT_OPTS="\
  --height 40% --layout=reverse --border \
  --color=bg+:#313244,bg:#1e1e2e,spinner:#f5e0dc,hl:#f38ba8 \
  --color=fg:#cdd6f4,header:#f38ba8,info:#cba6f7,pointer:#f5e0dc \
  --color=marker:#b4befe,fg+:#cdd6f4,prompt:#cba6f7,hl+:#f38ba8"
source <(fzf --zsh)

# syntax highlighting MUST be sourced last
source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
